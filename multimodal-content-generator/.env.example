# Copy this file to ".env" and fill in your real key.
# NEVER commit the real ".env" file to git (it's already in .gitignore).

# Get a free key at https://aistudio.google.com/apikey (no credit card
# required, generous free-tier rate limits).
GEMINI_API_KEY=your-key-here

# Which Gemini model to use. Free-tier eligible.
GEMINI_MODEL=gemini-3.6-flash
